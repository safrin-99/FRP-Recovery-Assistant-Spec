{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin minimum jendela utama: kontrol jendela kustom, event diagnosis, dan perintah diagnosis read-only yang di-allowlist. Tanpa shell, filesystem, HTTP, atau opener dari JS.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-check-platform-tools",
    "allow-detect-devices",
    "allow-start-diagnosis",
    "allow-cancel-diagnosis",
    "allow-check-driver-status",
    "allow-open-official-link"
  ]
}
